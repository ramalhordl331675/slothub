---
import Layout from '../../layouts/Base.astro';
import { verifySession } from '../../lib/auth';
import { getAdminClient } from '../../lib/supabase';

export const prerender = false;

const user = await verifySession(Astro.cookies);
let links: any[] = [];

if (user) {
  const supabase = getAdminClient();
  const { data } = await supabase
    .from('links_afiliados')
    .select('*')
    .order('ordem', { ascending: true });
  links = data || [];
}
---

<Layout title="Admin — SlotHub">
  <div class="container admin">
    {
      !user ? (
        <div class="login-wrap">
          <div class="login-card">
            <h1>🔐 Acesso Admin</h1>
            <p class="sub">Entre com sua conta do Supabase Auth.</p>
          <form id="login-form">
            <label>
              E-mail
              <input type="email" name="email" required autocomplete="username" placeholder="admin@exemplo.com" />
            </label>
            <label>
              Senha
              <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
            </label>
            <button type="submit" class="btn-primary">Entrar</button>
            <p id="login-error" class="error" hidden></p>
          </form>
            <a href="/" class="back">← Voltar ao site</a>
          </div>
        </div>
      ) : (
        <section class="dash">
          <header class="dash-top">
            <div>
              <h1>🎛️ Painel de Links</h1>
              <p class="sub">Gerencie os links de afiliados exibidos no site.</p>
            </div>
            <div class="actions">
              <a href="/" class="btn-ghost" target="_blank">Ver site ↗</a>
              <button id="logout-btn" class="btn-ghost danger">Sair</button>
            </div>
          </header>

          <!-- FORMULÁRIO ADICIONAR / EDITAR -->
          <form id="link-form" class="link-form">
            <h2 id="form-title">➕ Adicionar link</h2>
            <input type="hidden" name="id" id="f-id" />
            <div class="row">
              <label>
                Nome da plataforma *
                <input type="text" name="nome_plataforma" id="f-nome" required placeholder="Ex: BetStars" />
              </label>
              <label>
                Link de afiliado *
                <input type="url" name="link_afiliado" id="f-link" required placeholder="https://..." />
              </label>
            </div>
            <div class="row">
              <label>
                URL da imagem
                <input type="url" name="imagem_url" id="f-img" placeholder="https://.../logo.png" />
              </label>
              <label>
                Categoria
                <input type="text" name="categoria" id="f-cat" placeholder="Cassino / Slots / Poker" />
              </label>
            </div>
            <label>
              Descrição
              <textarea name="descricao" id="f-desc" rows="2" placeholder="Breve descrição do bônus..."></textarea>
            </label>
            <div class="row">
              <label>
                Cor de destaque
                <input type="color" name="cor_destaque" id="f-cor" value="#00ff88" />
              </label>
              <label>
                Ordem
                <input type="number" name="ordem" id="f-ordem" value="0" min="0" />
              </label>
              <label class="check">
                <input type="checkbox" name="ativo" id="f-ativo" checked />
                Ativo (visível no site)
              </label>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary" id="save-btn">Salvar link</button>
              <button type="button" class="btn-ghost" id="cancel-edit" hidden>Cancelar edição</button>
            </div>
            <p id="form-msg" class="error" hidden></p>
          </form>

          <!-- LISTA -->
          <div class="list-head">
            <h2>📋 Links cadastrados (<span id="count">{links.length}</span>)</h2>
          </div>
          <div id="links-list" class="links-list">
            {links.map((l) => (
              <div class="link-row" data-id={l.id} data-ativo={String(l.ativo)}>
                <div class="thumb-sm" style={`--accent:${l.cor_destaque || '#00ff88'}`}>
                  {l.imagem_url ? <img src={l.imagem_url} alt="" /> : <span>{(l.nome_plataforma || '?').charAt(0)}</span>}
                </div>
                <div class="info">
                  <strong>{l.nome_plataforma}</strong>
                  <small>{l.categoria || 'Sem categoria'}</small>
                </div>
                <span class={`status ${l.ativo ? 'on' : 'off'}`}>{l.ativo ? 'Ativo' : 'Inativo'}</span>
                <div class="row-actions">
                  <button class="btn-edit" data-id={l.id}>Editar</button>
                  <button class="btn-toggle" data-id={l.id}>{l.ativo ? 'Desativar' : 'Ativar'}</button>
                  <button class="btn-del" data-id={l.id}>Excluir</button>
                </div>
              </div>
            ))}
            {links.length === 0 && <p class="empty-list">Nenhum link ainda. Adicione o primeiro acima! 🚀</p>}
          </div>
        </section>
      )
    }
  </div>

  <script>
    // ===== LOGIN =====
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      const errEl = document.getElementById('login-error');
      const btn = loginForm.querySelector('button');
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errEl) errEl.hidden = true;
        btn.disabled = true;
        btn.textContent = 'Entrando...';
        const fd = new FormData(loginForm);
        let res;
        try {
          res = await fetch('/api/login', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }),
          });
        } catch {
          if (errEl) { errEl.textContent = 'Erro de conexão. Tente novamente.'; errEl.hidden = false; }
          btn.disabled = false; btn.textContent = 'Entrar';
          return;
        }
        let data = {};
        try { data = await res.json(); } catch {}
        if (!res.ok) {
          if (errEl) { errEl.textContent = (data && data.error) || 'Falha no login.'; errEl.hidden = false; }
          btn.disabled = false; btn.textContent = 'Entrar';
          return;
        }
        window.location.href = '/admin';
      });
      const params = new URLSearchParams(window.location.search);
      if (params.get('error') === '1' && errEl) {
        errEl.textContent = 'E-mail ou senha inválidos.';
        errEl.hidden = false;
      }
    }

    // ===== DASHBOARD =====
    const dashForm = document.getElementById('link-form');
    if (dashForm) {
      const listEl = document.getElementById('links-list');
      const countEl = document.getElementById('count');
      const formTitle = document.getElementById('form-title');
      const saveBtn = document.getElementById('save-btn');
      const cancelBtn = document.getElementById('cancel-edit');
      const formMsg = document.getElementById('form-msg');
      let editingId = null;

      function unauthorized(r) {
        if (r.status === 401) { window.location.href = '/admin'; return true; }
        return false;
      }
      function showMsg(text, isError = true) {
        formMsg.textContent = text; formMsg.hidden = false;
        formMsg.style.color = isError ? 'var(--danger)' : 'var(--accent)';
      }
      function resetForm() {
        editingId = null; dashForm.reset();
        document.getElementById('f-cor').value = '#00ff88';
        document.getElementById('f-ordem').value = '0';
        document.getElementById('f-ativo').checked = true;
        formTitle.textContent = '➕ Adicionar link';
        saveBtn.textContent = 'Salvar link';
        cancelBtn.hidden = true;
      }
      async function loadLinks() {
        try {
          const r = await fetch('/api/links', { headers: { 'content-type': 'application/json' } });
          if (unauthorized(r)) return;
          if (!r.ok) { showMsg('Erro ao carregar links.'); return; }
          const links = await r.json();
          countEl.textContent = String(links.length);
          renderList(links);
        } catch {
          showMsg('Erro de conexão ao carregar links.');
        }
      }
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
      }
      function renderList(links) {
        if (!links.length) { listEl.innerHTML = '<p class="empty-list">Nenhum link ainda. Adicione o primeiro acima! 🚀</p>'; return; }
        listEl.innerHTML = links.map((l) => `
          <div class="link-row" data-id="${l.id}" data-ativo="${l.ativo}">
            <div class="thumb-sm" style="--accent:${esc(l.cor_destaque || '#00ff88')}">
              ${l.imagem_url ? `<img src="${esc(l.imagem_url)}" alt="" />` : `<span>${esc((l.nome_plataforma || '?').charAt(0))}</span>`}
            </div>
            <div class="info">
              <strong>${esc(l.nome_plataforma)}</strong>
              <small>${esc(l.categoria || 'Sem categoria')}</small>
            </div>
            <span class="status ${l.ativo ? 'on' : 'off'}">${l.ativo ? 'Ativo' : 'Inativo'}</span>
            <div class="row-actions">
              <button class="btn-edit" data-id="${l.id}">Editar</button>
              <button class="btn-toggle" data-id="${l.id}">${l.ativo ? 'Desativar' : 'Ativar'}</button>
              <button class="btn-del" data-id="${l.id}">Excluir</button>
            </div>
          </div>`).join('');
      }
      dashForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        const fd = new FormData(dashForm);
        const payload = {
          nome_plataforma: fd.get('nome_plataforma'),
          link_afiliado: fd.get('link_afiliado'),
          imagem_url: fd.get('imagem_url') || null,
          descricao: fd.get('descricao') || null,
          categoria: fd.get('categoria') || null,
          cor_destaque: fd.get('cor_destaque'),
          ordem: Number(fd.get('ordem')) || 0,
          ativo: document.getElementById('f-ativo').checked,
        };
        const url = editingId ? `/api/links/${editingId}` : '/api/links';
        const method = editingId ? 'PUT' : 'POST';
        try {
          const r = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
          if (unauthorized(r)) return;
          const d = await r.json().catch(() => ({}));
          if (!r.ok) { showMsg(d.error || 'Erro ao salvar.'); return; }
          showMsg(editingId ? 'Link atualizado!' : 'Link criado!', false);
          resetForm();
          await loadLinks();
        } catch {
          showMsg('Erro de conexão ao salvar.');
        } finally {
          saveBtn.disabled = false;
        }
      });
      cancelBtn.addEventListener('click', resetForm);
      listEl.addEventListener('click', async (e) => {
        const t = e.target;
        const id = t.getAttribute('data-id');
        if (!id) return;
        if (t.classList.contains('btn-del')) {
          if (!confirm('Excluir este link permanentemente?')) return;
          const r = await fetch(`/api/links/${id}`, { method: 'DELETE' });
          if (unauthorized(r)) return;
          if (r.ok) await loadLinks(); else showMsg('Erro ao excluir.');
        }
        if (t.classList.contains('btn-toggle')) {
          const row = t.closest('.link-row');
          const ativoAtual = row.getAttribute('data-ativo') === 'true';
          const r = await fetch(`/api/links/${id}`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ativo: !ativoAtual }) });
          if (unauthorized(r)) return;
          if (r.ok) await loadLinks(); else showMsg('Erro ao alterar status.');
        }
        if (t.classList.contains('btn-edit')) {
          const r = await fetch('/api/links', { headers: { 'content-type': 'application/json' } });
          if (unauthorized(r)) return;
          if (!r.ok) return;
          const links = await r.json().catch(() => []);
          const l = links.find((x) => String(x.id) === String(id));
          if (!l) return;
          editingId = id;
          document.getElementById('f-id').value = l.id;
          document.getElementById('f-nome').value = l.nome_plataforma;
          document.getElementById('f-link').value = l.link_afiliado;
          document.getElementById('f-img').value = l.imagem_url || '';
          document.getElementById('f-cat').value = l.categoria || '';
          document.getElementById('f-desc').value = l.descricao || '';
          document.getElementById('f-cor').value = l.cor_destaque || '#00ff88';
          document.getElementById('f-ordem').value = l.ordem ?? 0;
          document.getElementById('f-ativo').checked = !!l.ativo;
          formTitle.textContent = `✏️ Editando: ${l.nome_plataforma}`;
          saveBtn.textContent = 'Atualizar link';
          cancelBtn.hidden = false;
          dashForm.scrollIntoView({ behavior: 'smooth' });
        }
      });
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST' });
        window.location.href = '/admin';
      });

      loadLinks();
    }
  </script>
</Layout>

<style>
  .admin { padding-bottom: 60px; }
  .sub { color: var(--muted); margin: 4px 0 0; }

  /* Login */
  .login-wrap { min-height: 70vh; display: flex; align-items: center; justify-content: center; }
  .login-card {
    width: 100%; max-width: 380px;
    background: linear-gradient(180deg, var(--card), var(--card-2));
    border: 1px solid var(--border); border-radius: 16px;
    padding: 28px; box-shadow: 0 20px 60px -20px #000;
  }
  .login-card h1 { margin: 0 0 4px; font-size: 1.4rem; }
  .login-card .back { display: inline-block; margin-top: 16px; color: var(--muted); font-size: .85rem; }

  /* Dashboard */
  .dash-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .dash-top h1 { margin: 0; font-size: 1.5rem; }
  .actions { display: flex; gap: 10px; }

  .link-form, .links-list {
    background: linear-gradient(180deg, var(--card), var(--card-2));
    border: 1px solid var(--border); border-radius: 16px;
    padding: 20px; margin-bottom: 22px;
  }
  .link-form h2, .list-head h2 { margin: 0 0 16px; font-size: 1.1rem; }

  label { display: flex; flex-direction: column; gap: 6px; font-size: .85rem; color: var(--muted); margin-bottom: 14px; }
  label input, label textarea {
    background: #0b0c18; border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 12px; color: var(--text); font-size: .95rem; font-family: inherit;
  }
  label input:focus, label textarea:focus { outline: none; border-color: var(--accent); }
  label.check { flex-direction: row; align-items: center; gap: 8px; color: var(--text); }
  label.check input { width: 18px; height: 18px; }

  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }

  .btn-primary {
    background: linear-gradient(90deg, var(--accent), var(--gold));
    color: #05060c; font-weight: 800; border: none; border-radius: 10px;
    padding: 11px 18px; cursor: pointer; font-size: .95rem;
  }
  .btn-primary:disabled { opacity: .6; cursor: default; }
  .btn-ghost {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    border-radius: 10px; padding: 9px 14px; cursor: pointer; font-size: .85rem; text-decoration: none;
  }
  .btn-ghost.danger:hover { border-color: var(--danger); color: var(--danger); }
  .form-actions { display: flex; gap: 10px; align-items: center; }

  .error { color: var(--danger); font-size: .85rem; margin: 10px 0 0; }

  /* Lista */
  .link-row {
    display: grid; grid-template-columns: 54px 1fr auto auto; gap: 14px; align-items: center;
    padding: 12px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 10px;
    background: #0e0f1e;
  }
  .thumb-sm {
    --accent: #00ff88; width: 54px; height: 38px; border-radius: 8px; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background: #05060c; color: var(--accent); font-weight: 900; font-size: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .thumb-sm img { width: 100%; height: 100%; object-fit: cover; }
  .info { display: flex; flex-direction: column; }
  .info strong { font-size: .98rem; }
  .info small { color: var(--muted); }
  .status { font-size: .75rem; padding: 4px 10px; border-radius: 999px; }
  .status.on { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .status.off { color: var(--muted); background: #ffffff10; }
  .row-actions { display: flex; gap: 8px; }
  .row-actions button {
    border: 1px solid var(--border); background: transparent; color: var(--text);
    border-radius: 8px; padding: 7px 10px; cursor: pointer; font-size: .8rem;
  }
  .row-actions .btn-edit:hover { border-color: var(--gold); }
  .row-actions .btn-toggle:hover { border-color: var(--accent); }
  .row-actions .btn-del:hover { border-color: var(--danger); color: var(--danger); }
  .empty-list { color: var(--muted); text-align: center; padding: 20px; }
</style>
