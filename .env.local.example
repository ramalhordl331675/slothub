# ===== Configuração do Supabase (SERVIDOR - nunca exposto ao navegador) =====
# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase.
# Dashboard Supabase -> Project Settings -> API

# URL do projeto (ex: https://xxxxxxxx.supabase.co)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" publica (usada no servidor apenas para ler dados públicos e validar sessão)
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave de "service_role" (SECRETA - usada no servidor para operações de admin/CRUD)
# NUNCA exponha esta chave no front-end.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui
